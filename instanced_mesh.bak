"""
Instanced meshing of homogeneous periodic lattice stacks.

Rationale: the slab pipeline in fourier_lattice marches the field over the
whole block, so the triangle count scales with the number of cells at
marching-cubes density, and downstream remeshing of the big STL is
expensive. For a HOMOGENEOUS, uniform-density stack the mesh itself is
periodic, so we can instead:

  1. mesh ONE unit cell, open at the cell faces (periodic boundary loops:
     the loops on face u=0 are the exact translates of face u=1);
  2. remesh/decimate it while keeping every boundary vertex bitwise fixed
     (quadric edge collapse with preserveboundary — verified exact), so
     the mesh stays periodic;
  3. instance it over (nx, ny, nz) cells with integer offsets and weld —
     coincident vertices are bitwise identical, so exact welding applies;
  4. cap the outer box faces with 'unit caps' built from the same field
     slices, whose rims reproduce the body boundary loops bitwise.

Not applicable to graded-density or heterogeneous stacks (cells are not
congruent there) — use fourier_lattice.stacked_lattice_mesh for those.

    import fourier_lattice as fl, instanced_mesh as im
    A, hkl, c = fl.octet_struts(node_comp=0.5)
    f = fl.field_on_grid(hkl, c, 96)
    verts, faces = im.instanced_stack_mesh(fl.cubic_cell(), f, rho=0.30,
                                           cells=(5, 5, 5), reduction=10)
    fl.write_stl("octet_5x5x5.stl", verts, faces)
"""

import numpy as np
from skimage.measure import marching_cubes
import fourier_lattice as fl


def _boundary_vertex_ids(faces):
    e = np.sort(faces[:, [0, 1, 1, 2, 2, 0]].reshape(-1, 2), axis=1)
    eu, cnt = np.unique(e, axis=0, return_counts=True)
    return np.unique(eu[cnt == 1])


def periodic_unit_mesh(f, rho):
    """Open mesh of one unit cell (index units, spans [0, N]^3): marching
    cubes on the wrap-closed field, no caps. Returns (verts, faces, level).
    Boundary loops lie exactly in the six cell faces and are periodic."""
    N = f.shape[0]
    t = np.quantile(f, 1.0 - rho)
    level = 1e-6 * (f.max() - f.min())
    F = np.pad(f, ((0, 1), (0, 1), (0, 1)), mode='wrap') - t
    v, fc, _, _ = marching_cubes(F, level=level)
    return v, fc, t


def remesh_periodic(verts, faces, reduction=10, quality_thr=0.3,
                    method='decimate', targetlen_pct=2.0, iterations=5):
    """
    Remesh the open unit-cell mesh keeping every boundary vertex bitwise
    fixed, so the mesh stays periodic and instanceable. Asserts that the
    boundary vertex set is unchanged.

    method='decimate'  : quadric edge collapse to len(faces)/reduction.
                         Fast, anisotropic triangles.
    method='isotropic' : isotropic explicit remeshing of the interior
                         (border selection frozen) at edge length
                         targetlen_pct % of the bbox diagonal. Better
                         element quality for FEA.
    """
    import pymeshlab
    ms = pymeshlab.MeshSet()
    ms.add_mesh(pymeshlab.Mesh(vertex_matrix=np.asarray(verts, np.float64),
                               face_matrix=np.asarray(faces)))
    if method == 'decimate':
        ms.meshing_decimation_quadric_edge_collapse(
            targetfacenum=int(len(faces) / reduction),
            preserveboundary=True, boundaryweight=1e6,
            preservenormal=True, planarquadric=True, qualitythr=quality_thr)
    elif method == 'isotropic':
        ms.compute_selection_from_mesh_border()
        for _ in range(2):
            ms.apply_selection_dilatation()
        ms.apply_selection_inverse(invfaces=True, invverts=True)
        ms.meshing_isotropic_explicit_remeshing(
            selectedonly=True, iterations=iterations, reprojectflag=True,
            targetlen=pymeshlab.PercentageValue(targetlen_pct))
    else:
        raise ValueError(method)
    m = ms.current_mesh()
    v2, f2 = m.vertex_matrix(), m.face_matrix()
    b1 = verts[_boundary_vertex_ids(faces)]
    b2 = v2[_boundary_vertex_ids(f2)]
    k1 = {tuple(x) for x in b1}
    k2 = {tuple(x) for x in b2}
    assert k1 == k2, "boundary loops changed during remeshing"
    return v2, f2


def _unit_face_cap(slice2d, side, level, pad_val):
    """Cap mesh for one cell face from its 2D field slice (already wrap-
    closed, shape (N+1, N+1)). Local coords (p, q, w): the cap lies in the
    w=0 plane after clamping. side=-1 -> low face, +1 -> high face."""
    M = slice2d.shape[0]
    F = np.empty((M, M, 2), np.float32)
    if side < 0:
        F[:, :, 0], F[:, :, 1] = pad_val, slice2d      # pad outside/below
    else:
        F[:, :, 0], F[:, :, 1] = slice2d, pad_val      # pad outside/above
    if not (F.min() < level < F.max()):
        return np.zeros((0, 3)), np.zeros((0, 3), int)
    v, fc, _, _ = marching_cubes(F, level=level)
    v[:, 2] = 1.0 if side < 0 else 0.0                 # flatten onto the face
    if side < 0:
        v[:, 2] -= 1.0                                 # local face plane w=0
    return v, fc


def instanced_stack_mesh(A, f, rho=0.3, cells=(1, 1, 1), remesh=True,
                         **remesh_kw):
    """
    Lean mesh of a homogeneous (nx, ny, nz) stack by unit-cell instancing.
    Returns (verts, faces) welded, outward normals, cartesian via A.
    """
    N = f.shape[0]
    nx, ny, nz = cells
    v0, f0, t = periodic_unit_mesh(f, rho)
    if remesh:
        v0, f0 = remesh_periodic(v0, f0, **remesh_kw)
    level = 1e-6 * (f.max() - f.min())
    pad_val = np.float32(f.min() - t - (f.max() - f.min()))

    all_v, all_f, nv = [], [], 0

    def add(v, fc, flip=False):
        nonlocal nv
        if len(fc) == 0:
            return
        all_v.append(v.astype(np.float32))
        all_f.append((fc[:, ::-1] if flip else fc) + nv)
        nv += len(v)

    # body: translated copies (integer offsets in index units -> exact)
    for i in range(nx):
        for j in range(ny):
            for k in range(nz):
                add(v0 + np.array([i, j, k], float) * N, f0)

    # caps: unit face caps instanced over each box face
    slices = [np.pad(f[0, :, :] - t, ((0, 1), (0, 1)), mode='wrap'),
              np.pad(f[:, 0, :] - t, ((0, 1), (0, 1)), mode='wrap'),
              np.pad(f[:, :, 0] - t, ((0, 1), (0, 1)), mode='wrap')]
    # local (p, q, w) -> global column order and permutation parity
    perm = {0: ([2, 0, 1], False), 1: ([0, 2, 1], True), 2: ([0, 1, 2], False)}
    n_ax = (nx, ny, nz)
    for ax in range(3):
        cols, odd = perm[ax]
        p_ax, q_ax = [a for a in range(3) if a != ax]
        for side in (-1, +1):
            vc, fc = _unit_face_cap(slices[ax], side, level, pad_val)
            if len(fc) == 0:
                continue
            w_off = 0.0 if side < 0 else n_ax[ax] * N
            for p in range(n_ax[p_ax]):
                for q in range(n_ax[q_ax]):
                    vv = vc + np.array([p * N, q * N, w_off])
                    add(vv[:, cols], fc, flip=odd)

    verts = np.concatenate(all_v)
    faces = np.concatenate(all_f).astype(np.int64)
    verts, faces = fl.weld(verts, faces)
    return (verts / N) @ np.asarray(A, np.float32), faces[:, ::-1]


if __name__ == "__main__":
    import time
    N, rho, cells = 96, 0.30, (5, 5, 5)
    A, hkl, c = fl.octet_struts(node_comp=0.5)
    f = fl.field_on_grid(hkl, c, N)

    t0 = time.time()
    v_i, f_i = instanced_stack_mesh(A, f, rho=rho, cells=cells,
                                    method='isotropic')
    t_inst = time.time() - t0
    t0 = time.time()
    v_s, f_s, _ = fl.stacked_lattice_mesh(A, f, rho=rho, cells=cells)
    t_slab = time.time() - t0
    Vbox = np.linalg.det(A) * np.prod(cells)
    print(f"instanced: {t_inst:5.1f}s  verts={len(v_i):9d}  "
          f"watertight={fl.is_watertight(f_i)}  "
          f"V/V_box={fl.mesh_volume(v_i, f_i)/Vbox:.4f}")
    print(f"slab     : {t_slab:5.1f}s  verts={len(v_s):9d}  "
          f"watertight={fl.is_watertight(f_s)}  "
          f"V/V_box={fl.mesh_volume(v_s, f_s)/Vbox:.4f}")
    fl.write_stl("/home/claude/octet_5x5x5_lean.stl", v_i, f_i)